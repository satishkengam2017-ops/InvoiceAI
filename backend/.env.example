# Supabase Postgres connection string (session-mode pooler, port 5432).
# The transaction-mode pooler (port 6543) is NOT supported - it causes
# DuplicatePreparedStatementError under SQLAlchemy's asyncpg dialect.
DATABASE_URL=postgresql+asyncpg://postgres.your-project-ref:your-password@your-region.pooler.supabase.com:5432/postgres
DATABASE_URL_DIRECT=postgresql+asyncpg://postgres.your-project-ref:your-password@your-region.pooler.supabase.com:5432/postgres

JWT_SECRET=change-me-to-a-long-random-string
CLERK_SECRET_KEY=

# Only needed for Stripe plan-upgrade webhooks.
STRIPE_WEBHOOK_SECRET=
STRIPE_STARTER_URL=
STRIPE_PRO_URL=

# Supabase project URL and Storage service-role key, used by
# POST /invoices/{id}/email-pdf to upload generated invoice PDFs to a
# public "InvoiceAI" Storage bucket. Also requires a one-time
# `playwright install chromium` after `pip install -r requirements.txt`
# (see README.md).
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Resend API credentials for sending the forgot-password reset code.
# Sent over HTTPS, not SMTP - Railway blocks outbound SMTP ports (465/587)
# on Trial/Hobby plans, so raw SMTP (even to your own mailbox) doesn't work
# there. RESEND_FROM_EMAIL must be an address on a domain verified in your
# Resend account.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
